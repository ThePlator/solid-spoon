{
  "manifest_version": 3,
  "name": "SuperMind — Save to your second brain",
  "version": "0.1.0",
  "description": "One-click save any page to your SuperMind library.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Save to SuperMind"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://supermind.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save the current page to SuperMind"
    }
  }
}

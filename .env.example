# ─────────────────────────────────────────────────────────────
# SuperMind — Firebase configuration
# Copy this file to .env.local and fill in values from your Firebase
# project: Console → Project settings → General → Your apps → Web app.
#
# NOTE: These "web config" values are safe to expose in client code —
# your security comes from firestore.rules, not from hiding these.
# Do NOT put service-account / admin keys here (those are secret).
#
# Each client reads these with its own prefix convention:
#   - Web (Next.js):     NEXT_PUBLIC_*
#   - Extension (Vite):  VITE_*
#   - Mobile (Expo):     EXPO_PUBLIC_*
# The raw values are identical; only the prefix differs. Duplicate the
# block your client needs, or use a shared loader.
# ─────────────────────────────────────────────────────────────

# --- Web (Next.js) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Extension (Vite) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# --- Mobile (Expo) ---
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Local development: use the Firebase Emulator Suite ---
# Set to "true" to point clients at local emulators instead of prod.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

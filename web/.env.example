# SuperMind web — environment variables.
# Copy to .env.local for local dev; set the same keys in the Vercel dashboard.
# NEVER commit real values (.env* is gitignored). See .claude/RULES.md.

# ---- Public Firebase web config (safe to expose in the client) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Where the client fires AI enrichment. Same-origin default is fine for web.
NEXT_PUBLIC_ENRICH_ENDPOINT=/api/enrich

# ---- Server-only secrets (v2 AI enrichment) — NEVER expose to the client ----
# Gemini API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional: override the model. Defaults to gemini-2.5-flash (clean JSON output).
ENRICH_MODEL=gemini-2.5-flash
# Firebase service-account JSON, as a single-line string (the whole file).
# Used by the enrich routes to verify tokens and write results back.
FIREBASE_SERVICE_ACCOUNT=
# Shared secret protecting the cron sweep. Set the same value in Vercel.
CRON_SECRET=
